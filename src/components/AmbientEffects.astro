<div class="ambient-effects" aria-hidden="true">
  <div class="sakura-layer"></div>
  <div class="click-effects"></div>
</div>

<style is:global>
  /* 调参入口：打字速度见 setTimeout(type, 52)；樱花间隔/数量见 setInterval(petal, 900) 与初始循环；点击粒子数量见循环 i < 14。 */
  .ambient-effects,
  .sakura-layer,
  .click-effects {
    position: fixed;
    inset: 0;
    pointer-events: none;
  }
  .ambient-effects {
    z-index: 8;
    overflow: hidden;
  }
  .sakura-layer {
    z-index: 0;
  }
  .click-effects {
    z-index: 1;
  }
  .petal {
    position: absolute;
    top: -24px;
    width: 10px;
    height: 7px;
    border-radius: 100% 0 100% 0;
    background: color-mix(in srgb, var(--paper-accent) 62%, #f6a6b8);
    opacity: 0.46;
    animation: petal-fall linear forwards;
  }
  .burst-particle {
    position: absolute;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background: var(--color);
    animation: burst var(--duration) cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
  }
  .burst-ring {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 1px solid var(--paper-accent);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    animation: ring 560ms ease-out forwards;
  }
  .typewriter-cursor {
    color: var(--paper-accent);
    animation: cursor-blink 800ms steps(2, end) infinite;
  }
  @keyframes petal-fall {
    to {
      transform: translate3d(var(--drift), 110vh, 0) rotate(var(--spin));
      opacity: 0;
    }
  }
  @keyframes burst {
    to {
      transform: translate3d(var(--x), var(--y), 0) scale(0.35);
      opacity: 0;
    }
  }
  @keyframes ring {
    to {
      width: 130px;
      height: 130px;
      opacity: 0;
    }
  }
  @keyframes cursor-blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ambient-effects {
      display: none;
    }
  }
</style>

<script is:inline>
  (() => {
    if (window.__navfolioAmbientEffects) return;
    window.__navfolioAmbientEffects = true;
    const mount = () => {
      let root = document.querySelector('.ambient-effects');
      if (!root) {
        root = document.createElement('div');
        root.className = 'ambient-effects';
        root.innerHTML = '<div class="sakura-layer"></div><div class="click-effects"></div>';
        document.body.append(root);
      }
      const sakura = root.querySelector('.sakura-layer');
      const clicks = root.querySelector('.click-effects');
      const typewriter = document.querySelector('[data-typewriter]');
      const existing = window.__navfolioTypewriter;
      // 页面切换后清理旧节点，避免计时器继续操作已卸载的元素。
      if (existing?.element !== typewriter) existing?.cleanup();
      if (typewriter && !window.__navfolioTypewriter) {
        const text = typewriter.getAttribute('aria-label') || '';
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        let index = 0;
        let timer = 0;
        let deadline = 0;
        let mode = 'typing';
        let paused = document.visibilityState === 'hidden';
        const cursor = document.createElement('span');
        cursor.textContent = '|';
        cursor.className = 'typewriter-cursor';
        typewriter.textContent = '';
        typewriter.append(cursor);

        // 统一管理计时器，便于暂停、恢复和页面卸载。
        const clearTimer = () => {
          if (timer) window.clearTimeout(timer);
          timer = 0;
        };
        const schedule = (delay, callback) => {
          clearTimer();
          deadline = Date.now() + delay;
          if (!paused) timer = window.setTimeout(callback, delay);
        };
        const type = () => {
          if (paused) return;
          if (index < text.length) {
            cursor.before(document.createTextNode(text[index++]));
            schedule(100, type);
            return;
          }
          // 打完后保留 30 秒，再从头开始播放。
          mode = 'waiting';
          cursor.remove();
          schedule(30_000, restart);
        };
        const restart = () => {
          if (paused) return;
          index = 0;
          mode = 'typing';
          typewriter.textContent = '';
          typewriter.append(cursor);
          type();
        };
        const onVisibilityChange = () => {
          // 后台标签页暂停倒计时，回到页面后继续剩余时间。
          if (document.visibilityState === 'hidden') {
            paused = true;
            if (timer) deadline = Math.max(0, deadline - Date.now());
            clearTimer();
            return;
          }
          paused = false;
          if (reducedMotion.matches) return;
          schedule(deadline ? deadline : 100, mode === 'waiting' ? restart : type);
        };
        const cleanup = () => {
          clearTimer();
          document.removeEventListener('visibilitychange', onVisibilityChange);
          delete window.__navfolioTypewriter;
        };
        window.__navfolioTypewriter = { element: typewriter, cleanup };
        document.addEventListener('visibilitychange', onVisibilityChange);
        if (reducedMotion.matches) {
          // 减少动态效果时直接显示完整文案。
          cleanup();
          typewriter.textContent = text;
        } else {
          type();
        }
      }
      if (!sakura || sakura.dataset.ready) return;
      sakura.dataset.ready = 'true';
      const petal = () => {
        const node = document.createElement('i');
        node.className = 'petal';
        node.style.left = `${Math.random() * 100}%`;
        node.style.setProperty('--drift', `${(Math.random() - 0.5) * 180}px`);
        node.style.setProperty('--spin', `${360 + Math.random() * 540}deg`);
        node.style.animationDuration = `${8 + Math.random() * 8}s`;
        node.style.transform = `rotate(${Math.random() * 180}deg)`;
        sakura.append(node);
        node.addEventListener('animationend', () => node.remove());
      };
      setInterval(petal, 300);
      for (let i = 0; i < 20; i++) setTimeout(petal, i * 450);
      document.addEventListener('click', (event) => {
        if (!clicks) return;
        const ring = document.createElement('i');
        ring.className = 'burst-ring';
        ring.style.left = `${event.clientX}px`;
        ring.style.top = `${event.clientY}px`;
        clicks.append(ring);
        ring.addEventListener('animationend', () => ring.remove());
        for (let i = 0; i < 30; i++) {
          const particle = document.createElement('i');
          particle.className = 'burst-particle';
          const angle = (Math.PI * 2 * i) / 14 + (Math.random() - 0.5) * 0.35;
          const distance = 28 + Math.random() * 42;
          particle.style.left = `${event.clientX}px`;
          particle.style.top = `${event.clientY}px`;
          particle.style.setProperty('--x', `${Math.cos(angle) * distance}px`);
          particle.style.setProperty('--y', `${Math.sin(angle) * distance}px`);
          particle.style.setProperty('--size', `${15 + Math.random() * 3}px`);
          particle.style.setProperty('--duration', `${420 + Math.random() * 180}ms`);
          particle.style.setProperty(
            '--color',
            ['#e99b9b', '#e7b85d', '#82b894', '#82a9cf'][i % 4],
          );
          clicks.append(particle);
          particle.addEventListener('animationend', () => particle.remove());
        }
      });
    };
    mount();
    document.addEventListener('astro:page-load', mount);
  })();
</script>
