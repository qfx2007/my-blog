---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Payload {
  contributions?: Record<string, number>;
  sources?: { github?: number; gitee?: number };
}
let payload: Payload = {};
try {
  payload = JSON.parse(readFileSync(join(process.cwd(), 'public/contributions.json'), 'utf8'));
} catch {}
const today = new Date();
today.setHours(0, 0, 0, 0);
const stored = payload.contributions ?? {};
const values = Array.from({ length: 30 }, (_, index) => {
  const date = new Date(today);
  date.setDate(today.getDate() - (29 - index));
  const key = date.toISOString().slice(0, 10);
  return [key, stored[key] ?? 0] as [string, number];
});
const max = Math.max(1, ...values.map(([, count]) => count));
const total = values.reduce((sum, [, count]) => sum + count, 0);
const level = (count: number) => (count === 0 ? 0 : Math.min(4, Math.ceil((count / max) * 4)));
const format = new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'Asia/Shanghai',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="glass-card contribution-card" aria-label="GitHub 和 Gitee 贡献热力图">
  <header>
    <strong>贡献记录</strong>
    <span>最近30天: {total} 次</span>
  </header>
  <div class="contribution-grid">
    {values.map(([date, count]) => (
      <time
        datetime={date}
        class={`contribution-day level-${level(count)}`}
        title={`${format.format(new Date(`${date}T12:00:00+08:00`))} · 共${count}次贡献`}
        aria-label={`${format.format(new Date(`${date}T12:00:00+08:00`))} · 共${count}次贡献`}
        role="button"
        tabindex="0"
        data-contribution-day
      ></time>
    ))}
  </div>
  <div class="contribution-legend" aria-label="贡献次数图例">
    <span>少</span>
    <i class="level-0"></i>
    <i class="level-1"></i>
    <i class="level-2"></i>
    <i class="level-3"></i>
    <i class="level-4"></i>
    <span>多</span>
  </div>
</article>
<style>
  .contribution-card {
    display: grid;
    gap: 12px;
    padding: 18px 0;
    border: 0;
    background: transparent;
    box-shadow: none;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    color: var(--paper-ink);
  }
  header span {
    color: var(--paper-ink-soft);
    font-size: 0.7rem;
  }
  .contribution-grid {
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    grid-template-rows: repeat(3, minmax(0, 1fr));
    grid-auto-flow: column;
    gap: 3px;
    aspect-ratio: 10/3;
  }
  .contribution-day {
    position: relative;
    min-width: 0;
    border-radius: 2px;
    background: var(--paper-control);
  }

  .contribution-day::after {
    position: absolute;
    z-index: 2;
    bottom: calc(100% + 6px);
    left: 50%;
    width: max-content;
    max-width: 180px;
    padding: 5px 7px;
    color: var(--paper-bg);
    font-size: 0.68rem;
    line-height: 1.3;
    white-space: nowrap;
    background: var(--paper-ink);
    border-radius: 4px;
    content: attr(aria-label);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 4px);
    transition:
      opacity 120ms ease,
      transform 120ms ease;
  }

  .contribution-day.is-active::after {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (min-width: 821px) {
    .contribution-day::after {
      display: none;
    }
  }
  .contribution-legend {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 3px;
    color: var(--paper-ink-soft);
    font-size: 0.68rem;
  }
  .contribution-legend i {
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 1px;
  }
  .level-1 {
    background: color-mix(in srgb, var(--paper-accent) 28%, var(--paper-control));
  }
  .level-2 {
    background: color-mix(in srgb, var(--paper-accent) 48%, var(--paper-control));
  }
  .level-3 {
    background: color-mix(in srgb, var(--paper-accent) 70%, var(--paper-control));
  }
  .level-4 {
    background: var(--paper-accent);
  }
  @media (max-width: 820px) {
    .contribution-card {
      padding: 0;
    }
    .contribution-grid {
      gap: 2px;
    }

    .contribution-day {
      cursor: pointer;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contribution-day::after {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    if (window.__navfolioContributionTooltip) return;
    window.__navfolioContributionTooltip = true;
    const selector = '[data-contribution-day]';
    const close = () =>
      document.querySelectorAll(`${selector}.is-active`).forEach((day) => {
        day.classList.remove('is-active');
      });
    const toggle = (day) => {
      const active = day.classList.contains('is-active');
      close();
      if (!active) day.classList.add('is-active');
    };

    document.addEventListener('click', (event) => {
      const day = event.target.closest?.(selector);
      if (day && window.matchMedia('(max-width: 820px)').matches) {
        toggle(day);
        return;
      }
      if (!day) close();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
      if ((event.key === 'Enter' || event.key === ' ') && event.target.matches?.(selector)) {
        event.preventDefault();
        if (window.matchMedia('(max-width: 820px)').matches) toggle(event.target);
      }
    });
  })();
</script>
