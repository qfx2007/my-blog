---
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import { getSiteConfig } from '../../data/site';
import { createRecentBlogHeatmap } from '../../utils/blog-heatmap';
import { getUiText } from '../../utils/ui-text';

interface Props {
  showLatest?: boolean;
  latestCount?: number;
  excludeDraft?: boolean;
  totalPostsBase?: number;
  activeDaysBase?: number;
  dayStreakBase?: number;
}

const {
  showLatest = true,
  latestCount = 1,
  excludeDraft = true,
  totalPostsBase = 0,
  activeDaysBase = 0,
  dayStreakBase = 0,
} = Astro.props;
const posts = await getCollection('blog', ({ data }) => !excludeDraft || !data.draft);
const heatmap = createRecentBlogHeatmap(posts, latestCount);
const ui = getUiText(await getSiteConfig());
const formatDate = new Intl.DateTimeFormat(ui.locale, {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<article class="glass-card heatmap-card">
  <div class="stats-row">
    <div class="stat-item">
      <strong>{heatmap.totalPosts + totalPostsBase}</strong>
      <span>{ui.heatmap.totalPosts}</span>
    </div>
    <div class="stat-item">
      <strong>{heatmap.activeDays + activeDaysBase}</strong>
      <span>{ui.heatmap.activeDays}</span>
    </div>
    <div class="stat-item">
      <strong>{heatmap.currentStreak + dayStreakBase}</strong>
      <span>{ui.heatmap.dayStreak}</span>
    </div>
  </div>

  {
    showLatest && heatmap.latestPosts.length > 0 && (
      <aside class="latest-tip" aria-label={ui.heatmap.latestPublishedPosts}>
        <strong>{ui.heatmap.latest}</strong>
        <div class="latest-list">
          {heatmap.latestPosts.map((post) => (
            <a
              class="latest-link"
              href={post.href}
              aria-label={ui.heatmap.openLatestPost(post.title)}
            >
              <em>{post.title}</em>
              <time datetime={post.date.toISOString()}>{formatDate.format(post.date)}</time>
              <span class="latest-icon" aria-hidden="true">
                <Icon name="external" size={15} />
              </span>
            </a>
          ))}
        </div>
      </aside>
    )
  }
</article>

<style>
  .heatmap-card {
    display: grid;
    gap: 16px;
    padding: 20px;
    border-color: transparent;
    background: transparent;
    box-shadow: none;
    overflow: visible;
  }

  .heatmap-card:hover {
    border-color: transparent;
    box-shadow: none;
    transform: none;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .stat-item {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .stat-item strong {
    color: var(--paper-ink);
    font-size: 1.12rem;
    line-height: 1;
  }

  .stat-item span {
    overflow: hidden;
    color: var(--paper-ink-soft);
    font-size: 0.72rem;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .latest-tip {
    display: grid;
    gap: 6px;
    padding: 10px 11px;
    border: 1px solid var(--paper-line);
    border-radius: 7px;
    background: var(--paper-surface-muted);
  }

  .latest-list {
    display: grid;
    gap: 4px;
  }

  .latest-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content 24px;
    align-items: center;
    min-width: 0;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }

  .latest-tip strong {
    color: var(--paper-accent);
    font-size: 0.7rem;
    line-height: 1.15;
  }

  .latest-tip em {
    overflow: hidden;
    color: var(--paper-ink);
    font-size: 0.8rem;
    font-style: normal;
    font-weight: 650;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .latest-tip time {
    color: var(--paper-ink-soft);
    font-size: 0.68rem;
    line-height: 1;
    white-space: nowrap;
  }

  .latest-icon {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 8px;
    color: var(--paper-accent);
    transition:
      background 180ms ease,
      transform 180ms ease;
  }

  .latest-link:hover .latest-icon,
  .latest-link:focus-visible .latest-icon {
    background: var(--paper-control-hover);
    transform: translateY(-1px);
  }

  .latest-link:focus-visible {
    border-radius: 7px;
    outline: 2px solid color-mix(in srgb, var(--paper-accent) 28%, transparent);
    outline-offset: 3px;
  }

  @media (max-width: 820px) {
    .heatmap-card {
      gap: 14px;
      padding: 0;
      overflow: hidden;
    }
  }
</style>
