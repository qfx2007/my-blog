---
import { AlarmClock, ChartNoAxesColumnIncreasing, Sparkles, Users } from 'lucide-astro';
import feather from '../../assets/figure/yumaobi.png';
---

<section class="site-stats" aria-labelledby="site-stats-title" data-site-stats>
  <div class="site-stats-panel site-stats-info">
    <div class="site-stats-header">
      <div class="site-stats-heading">
        <img src={feather.src} alt="" />
        <h2 id="site-stats-title">站点信息</h2>
      </div>
      <div class="site-stats-divider" aria-hidden="true"></div>
    </div>
    <div class="site-stats-items">
      <div class="site-stat" title="从本站成功部署的那天开始计算">
        <AlarmClock size={18} strokeWidth={1.7} aria-hidden="true" />
        <div class="site-stat-text">
          <strong data-running-days>—</strong>
          <span>运行时间</span>
        </div>
      </div>
      <div class="site-stat" title="本站独立访客数，数据来自 51.LA 统计接口">
        <Users size={18} strokeWidth={1.7} aria-hidden="true" />
        <div class="site-stat-text">
          <strong data-total-uv>—</strong>
          <span>访客人数</span>
        </div>
      </div>
      <div class="site-stat" title="本站所有页面浏览量，数据来自 51.LA 统计接口">
        <ChartNoAxesColumnIncreasing size={18} strokeWidth={1.7} aria-hidden="true" />
        <div class="site-stat-text">
          <strong data-total-pv>—</strong>
          <span>访问量</span>
        </div>
      </div>
    </div>
  </div>
  <div class="site-stats-panel site-stats-music">
    <div class="site-stats-header">
      <Sparkles class="site-stats-sparkles" size={18} strokeWidth={1.7} aria-hidden="true" />
      <div class="site-stats-divider" aria-hidden="true"></div>
    </div>
    <div class="music-player" data-music-player>
      <img class="music-cover" src="/music/cover.png" alt="音乐唱片封面" />
      <div class="music-controls">
        <div class="music-progress-row">
          <input
            data-music-progress
            type="range"
            min="0"
            max="100"
            value="0"
            aria-label="播放进度"
          />
          <span data-music-time>0:00</span>
        </div>
        <div class="music-buttons">
          <button type="button" data-music-prev aria-label="上一首">
            ↶
          </button>
          <button type="button" data-music-toggle aria-label="播放">
            ▶
          </button>
          <button type="button" data-music-next aria-label="下一首">
            ↷
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .site-stats {
    display: grid;
    width: 100%;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    margin-top: 10px;
    color: var(--paper-ink);
  }

  .site-stats-panel {
    position: relative;
    min-width: 0;
    width: 100%;
  }

  .site-stats-info {
    padding: 18px 28px 20px 0;
  }

  .site-stats-info::after {
    position: absolute;
    top: 58px;
    right: 0;
    bottom: 20px;
    width: 1px;
    background: color-mix(in srgb, var(--paper-accent) 20%, transparent);
    content: '';
  }

  .site-stats-music {
    padding: 18px 0 20px 28px;
  }

  .site-stats-header {
    display: flex;
    align-items: center;
    min-height: 22px;
    gap: 12px;
  }

  .site-stats-heading {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--paper-accent);
  }

  .site-stats-heading img {
    display: block;
    width: auto;
    height: auto;
    max-width: 23px;
    max-height: 22px;
    flex: 0 0 auto;
  }

  h2 {
    margin: 0;
    font-family: var(--font-note);
    font-size: 1rem;
    font-weight: 700;
  }

  .site-stats-divider {
    flex: 1;
    height: 1px;
    background: color-mix(in srgb, var(--paper-accent) 20%, transparent);
  }

  .site-stats-sparkles {
    flex: 0 0 auto;
    color: var(--paper-accent);
  }

  .site-stats-items {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 3vw, 36px);
    margin-top: 16px;
  }

  .site-stat {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
    min-width: 0;
    color: var(--paper-accent);
  }

  .site-stat svg {
    flex: 0 0 auto;
  }

  .site-stat-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .site-stat strong {
    color: var(--paper-ink);
    font-family: var(--font-code);
    font-size: 1rem;
    line-height: 1.1;
    font-weight: 700;
  }

  .site-stat span {
    color: var(--paper-ink-soft);
    font-size: 0.72rem;
  }

  .music-player {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 54px;
  }
  .music-cover {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    object-fit: cover;
  }

  .music-player.is-playing .music-cover {
    animation: music-cover-spin 12s linear infinite;
    will-change: transform;
  }

  @keyframes music-cover-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  .music-controls {
    flex: 1;
    min-width: 0;
  }
  .music-progress-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .music-progress-row input {
    flex: 1;
    accent-color: var(--paper-accent);
  }
  .music-progress-row span {
    color: var(--paper-ink-soft);
    font: 0.7rem var(--font-code);
  }
  .music-buttons {
    display: flex;
    justify-content: center;
    gap: 14px;
    margin-top: 4px;
  }
  .music-buttons button {
    border: 0;
    background: transparent;
    color: var(--paper-accent);
    cursor: pointer;
    font-size: 1rem;
  }
  .music-buttons button:hover {
    color: var(--paper-ink);
  }

  @media (max-width: 920px) {
    .site-stats {
      grid-template-columns: 1fr;
    }

    .site-stats-info,
    .site-stats-music {
      padding: 18px 0 20px;
      border-right: 0;
    }

    .site-stats-info::after {
      display: none;
    }

    .site-stats-music {
      padding-top: 0;
    }
  }

  @media (max-width: 640px) {
    .site-stats {
      margin-top: 0;
    }

    .site-stats-items {
      width: 100%;
      gap: 0;
      justify-content: space-evenly;
    }

    .site-stat {
      flex: 1 1 0;
      justify-content: center;
      gap: 6px;
    }

    .site-stat-text {
      align-items: center;
      text-align: center;
    }

    .site-stat svg {
      width: 16px;
      height: 16px;
    }

    .site-stat strong {
      font-size: 0.9rem;
    }

    .site-stat span {
      font-size: 0.65rem;
    }
  }
</style>
<script>
  const setupSiteStats = () => {
    const root = document.querySelector('[data-site-stats]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';
    const startedAt = new Date('2026-07-30T00:00:00+08:00');
    const days = Math.max(1, Math.floor((Date.now() - startedAt.getTime()) / 86400000) + 1);
    root.querySelector('[data-running-days]')!.textContent = `${days} 天`;
    fetch('/api/site-stats')
      .then((response) => (response.ok ? response.json() : Promise.reject()))
      .then((stats: { totalUv: number; totalPv: number }) => {
        root.querySelector('[data-total-uv]')!.textContent = stats.totalUv.toLocaleString('zh-CN');
        root.querySelector('[data-total-pv]')!.textContent = stats.totalPv.toLocaleString('zh-CN');
      })
      .catch(() => undefined);
  };

  setupSiteStats();
  document.addEventListener('astro:page-load', setupSiteStats);
</script>

<script>
  const tracks = ['/music/track-1.mp3', '/music/track-2.mp3'];
  const state = (window.__navfolioMusic ??= { audio: new Audio(), index: 0, ready: false });
  const setupMusic = () => {
    state.cleanup?.();
    const root = document.querySelector('[data-music-player]');
    if (!root) return;
    const toggle = root.querySelector('[data-music-toggle]');
    const progress = root.querySelector('[data-music-progress]');
    const time = root.querySelector('[data-music-time]');
    if (!state.ready) {
      state.audio.src = tracks[0];
      state.audio.preload = 'metadata';
      state.audio.addEventListener('ended', () => {
        state.index = (state.index + 1) % tracks.length;
        state.audio.src = tracks[state.index];
        state.audio.play().catch(() => undefined);
      });
      state.ready = true;
    }
    const sync = () => {
      root.classList.toggle('is-playing', !state.audio.paused);
      toggle.textContent = state.audio.paused ? '▶' : 'Ⅱ';
      toggle.setAttribute('aria-label', state.audio.paused ? '播放' : '暂停');
      progress.value = state.audio.duration
        ? String((state.audio.currentTime / state.audio.duration) * 100)
        : '0';
      time.textContent = `${Math.floor(state.audio.currentTime / 60)}:${String(Math.floor(state.audio.currentTime % 60)).padStart(2, '0')}`;
    };
    const change = (step) => {
      state.index = (state.index + step + tracks.length) % tracks.length;
      state.audio.src = tracks[state.index];
      state.audio.play().catch(() => undefined);
    };
    toggle.onclick = () =>
      state.audio.paused ? state.audio.play().catch(() => undefined) : state.audio.pause();
    root.querySelector('[data-music-prev]').onclick = () => change(-1);
    root.querySelector('[data-music-next]').onclick = () => change(1);
    progress.oninput = () => {
      if (state.audio.duration)
        state.audio.currentTime = (Number(progress.value) / 100) * state.audio.duration;
    };
    state.audio.addEventListener('timeupdate', sync);
    state.audio.addEventListener('play', sync);
    state.audio.addEventListener('pause', sync);
    sync();
  };
  setupMusic();
  document.addEventListener('astro:page-load', setupMusic);
</script>
