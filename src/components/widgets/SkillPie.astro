---
interface SkillItem {
  name: string;
  value: number;
  category: '语言' | '技术栈' | '工具和其他';
  color?: string;
  tools?: string[];
}
interface Props {
  items: SkillItem[];
}
const { items } = Astro.props;
const colors = [
  '#f8f1b4',
  '#fbe2b0',
  '#f7cba0',
  '#efd9b8',
  '#d7edc7',
  '#c5e8b8',
  '#b9e4d4',
  '#c0e6f4',
  '#b5d8f0',
  '#c9cbed',
  '#e2c9e6',
  '#f6cde2',
  '#f3d9c7',
  '#eae2c7',
  '#d2e9d3',
  '#c8e6ef',
  '#dbecc0',
  '#f4e9b8',
  '#eadfbf',
  '#c7e3d1',
  '#d5f1de',
  '#bde4f5',
  '#d9d2f3',
  '#f2e2d0',
  '#e1f2c5',
];
const grouped = items.reduce<Record<string, SkillItem[]>>((acc, item) => {
  (acc[item.category] ||= []).push(item);
  return acc;
}, {});
---

<section
  class="skill-widget"
  data-skill-widget
  data-items={JSON.stringify(items)}
  data-colors={JSON.stringify(colors)}
>
  <div class="skill-widget__main">
    <div class="skill-widget__chart" data-chart>
      <!-- donut svg injected by script -->
    </div>
    <div class="skill-widget__rows" data-rows>
      {Object.entries(grouped).map(([category, list]) => {
        const chips = list.flatMap((item) =>
          (item.tools || [item.name]).map((name) => (
            <span
              key={`${category}-${name}`}
              class="skill-pill"
              style={`--skill-color:${item.color || colors[items.indexOf(item) % colors.length]}`}
              data-skill-name={name}
            >
              {name} <i>{item.tools ? '+++' : '+'.repeat(item.value)}</i>
            </span>
          )),
        );
        return (
          <div class="skill-row" data-category={category}>
            <span class="skill-row__head">
              {category === '语言' && (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="8 6 3 12 8 18" />
                  <polyline points="16 6 21 12 16 18" />
                </svg>
              )}
              {category === '技术栈' && (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polygon points="12 2 2 7 12 12 22 7 12 2" />
                  <polyline points="2 17 12 22 22 17" />
                  <polyline points="2 12 12 17 22 12" />
                </svg>
              )}
              {category === '工具和其他' && (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
                  <line x1="12" y1="22.08" x2="12" y2="12" />
                </svg>
              )}
              <b>{category}:</b>
            </span>
            <div class="skill-row__chips">
              <div class="skill-row__track">
                <div class="skill-row__group">{chips}</div>
                <div class="skill-row__group" aria-hidden="true">
                  {chips}
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
<script>
  const setup = () =>
    document.querySelectorAll<HTMLElement>('[data-skill-widget]').forEach((host) => {
      if (host.dataset.wired) return;
      host.dataset.wired = 'true';
      const items = JSON.parse(host.dataset.items || '[]') as {
          name: string;
          value: number;
          category: string;
          color?: string;
          tools?: string[];
        }[],
        colors = JSON.parse(host.dataset.colors || '[]') as string[],
        total = items.reduce((s, i) => s + i.value, 0) || 1,
        size = 360,
        c = 180,
        o = 160,
        inn = 92,
        ns = 'http://www.w3.org/2000/svg';
      const svg = document.createElementNS(ns, 'svg');
      svg.setAttribute('viewBox', `0 0 ${size} ${size}`);
      svg.setAttribute('role', 'img');
      svg.setAttribute('aria-label', '职业技能分布');
      const centerMain = document.createElementNS(ns, 'text');
      centerMain.setAttribute('x', String(c));
      centerMain.setAttribute('y', String(c - 4));
      centerMain.setAttribute('text-anchor', 'middle');
      centerMain.setAttribute('class', 'pie-center-main');
      centerMain.textContent = `${items.length}+`;
      const centerSub = document.createElementNS(ns, 'text');
      centerSub.setAttribute('x', String(c));
      centerSub.setAttribute('y', String(c + 30));
      centerSub.setAttribute('text-anchor', 'middle');
      centerSub.setAttribute('class', 'pie-center-sub');
      centerSub.textContent = '技术技能';
      svg.appendChild(centerMain);
      svg.appendChild(centerSub);
      const polar = (r: number, a: number) => [c + r * Math.cos(a), c + r * Math.sin(a)],
        path = (a: number, b: number) => {
          const [x1, y1] = polar(o, a),
            [x2, y2] = polar(o, b),
            [x3, y3] = polar(inn, b),
            [x4, y4] = polar(inn, a),
            l = b - a > Math.PI ? 1 : 0;
          return `M${x1} ${y1}A${o} ${o} 0 ${l} 1 ${x2} ${y2}L${x3} ${y3}A${inn} ${inn} 0 ${l} 0 ${x4} ${y4}Z`;
        },
        profWord = (v: number) => ['了解', '熟悉', '熟练'][v - 1] ?? '了解';
      let angle = -Math.PI / 2;
      const sliceEls: SVGGElement[] = [];
      let selected = -1;
      const isChipActive = (el: HTMLElement) =>
        selected >= 0 &&
        (el.dataset.skillName === items[selected].name ||
          (items[selected].tools || []).includes(el.dataset.skillName || ''));
      const select = (i: number) => {
        selected = selected === i ? -1 : i;
        host.classList.toggle('has-selection', selected >= 0);
        sliceEls.forEach((g, j) => g.classList.toggle('is-selected', j === selected));
        host
          .querySelectorAll<HTMLElement>('[data-skill-name]')
          .forEach((el) => el.classList.toggle('is-active', isChipActive(el)));
        if (selected < 0) {
          centerMain.textContent = `${items.length}+`;
          centerMain.style.fontSize = '';
          centerSub.textContent = '技术技能';
        } else {
          const item = items[selected],
            pct = ((item.value / total) * 100).toFixed(1);
          centerMain.textContent = item.name;
          centerMain.style.fontSize = '22px';
          centerSub.textContent = `${profWord(item.value)}·${pct}%`;
        }
      };
      items.forEach((item, i) => {
        const sweep = (item.value / total) * Math.PI * 2,
          start = angle,
          end = angle + sweep,
          mid = (start + end) / 2;
        angle = end;
        const g = document.createElementNS(ns, 'g'),
          p = document.createElementNS(ns, 'path');
        g.classList.add('skill-slice');
        g.style.setProperty('--explode-x', `${Math.cos(mid) * 24}px`);
        g.style.setProperty('--explode-y', `${Math.sin(mid) * 24}px`);
        p.setAttribute('d', path(start, end));
        p.style.fill = item.color || colors[i % colors.length];
        p.setAttribute('aria-label', `${item.name}，${item.category}`);
        g.appendChild(p);
        svg.appendChild(g);
        sliceEls.push(g);
        g.addEventListener('click', () => select(i));
      });
      host.querySelectorAll<HTMLElement>('[data-skill-name]').forEach((el) => {
        el.addEventListener('click', () => {
          const idx = items.findIndex(
            (it) =>
              it.name === el.dataset.skillName ||
              (it.tools || []).includes(el.dataset.skillName || ''),
          );
          if (idx >= 0) select(idx);
        });
      });
      host.querySelector('[data-chart]')?.appendChild(svg);
    });
  setup();
  document.addEventListener('astro:page-load', setup);
</script>
<style is:global>
  .skill-widget {
    display: grid;
    gap: 12px;
    margin: 6px 0 10px;
  }
  .skill-widget__main {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 14px 22px;
    align-items: center;
  }
  .skill-widget__chart {
    width: 236px;
    min-width: 0;
    justify-self: start;
  }
  .skill-widget__chart svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .pie-center-main {
    font-family: var(--font-heading);
    font-size: 44px;
    font-weight: 700;
    fill: var(--paper-ink);
  }
  .pie-center-sub {
    font-family: var(--font-heading);
    font-size: 16px;
    fill: var(--paper-ink-soft);
  }
  .skill-widget__rows {
    display: grid;
    gap: 11px;
    min-width: 0;
  }
  .skill-row {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .skill-row__head {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: none;
    color: var(--paper-ink);
    font-size: 0.82rem;
    white-space: nowrap;
  }
  .skill-row__head b {
    font-weight: 650;
  }
  .skill-row__head svg {
    width: 17px;
    height: 17px;
    flex: none;
    color: var(--paper-accent);
  }
  .skill-row__chips {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    padding: 3px 0;
  }
  .skill-row__track {
    display: flex;
    width: max-content;
    animation: skill-marquee 28s linear infinite;
  }
  .skill-row__group {
    display: flex;
    flex: none;
    gap: 8px;
    padding-right: 8px;
  }
  .skill-row:hover .skill-row__track {
    animation-play-state: paused;
  }
  @keyframes skill-marquee {
    to {
      transform: translateX(-50%);
    }
  }
  .skill-pill {
    flex: none;
    border: 1px solid color-mix(in srgb, var(--skill-color) 38%, transparent);
    background: color-mix(in srgb, var(--skill-color) 9%, transparent);
    color: color-mix(in srgb, var(--skill-color) 78%, var(--paper-ink));
    border-radius: 999px;
    padding: 3px 11px;
    font-size: 0.74rem;
    line-height: 1.5;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background 0.28s ease,
      color 0.28s ease,
      border-color 0.28s ease,
      transform 0.28s ease;
  }
  .skill-pill i {
    font-style: normal;
    font-weight: 700;
    margin-left: 2px;
    color: var(--skill-color);
    font-size: 0.7rem;
  }
  .skill-pill:hover {
    border-color: color-mix(in srgb, var(--skill-color) 70%, transparent);
  }
  .skill-pill.is-active {
    background: var(--skill-color);
    border-color: var(--skill-color);
    color: var(--paper-surface);
    transform: translateY(-1px);
  }
  .skill-pill.is-active i {
    color: var(--paper-surface);
    opacity: 0.85;
  }
  .skill-slice {
    transform: translate(0, 0);
    transform-origin: 180px 180px;
    transition: transform 0.34s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .skill-slice path {
    stroke: var(--paper-surface);
    stroke-width: 2;
    cursor: pointer;
    transition:
      filter 0.3s ease,
      opacity 0.3s ease;
  }
  .skill-slice.is-selected {
    transform: translate(var(--explode-x), var(--explode-y));
  }
  .skill-widget.has-selection .skill-slice:not(.is-selected) path {
    opacity: 0.42;
  }
  .skill-slice.is-selected path {
    filter: drop-shadow(0 6px 14px rgba(60, 45, 30, 0.35));
  }
  @media (max-width: 560px) {
    .skill-widget__main {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 14px;
    }
    .skill-widget__chart {
      justify-self: center;
      width: 210px;
    }
    .skill-widget__rows {
      width: 100%;
      justify-self: stretch;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .skill-slice,
    .skill-slice path,
    .skill-pill {
      transition: none;
    }
    .skill-row__track {
      animation: none;
    }
  }
</style>
