---
// 关于页职业技能饼图：左图例 + 右饼图，点击图例/扇区凸出对应数据项。
// 构建时直接生成 SVG，不依赖 ECharts；无 JS 时饼图与图例仍然完整可读，
// 悬停/点击只负责高亮与凸出。
interface SkillItem {
  name: string;
  /** 等级权重：3 熟练 / 2 熟悉 / 1 了解——同时决定扇区角度与配色深浅 */
  value: number;
}

interface Props {
  items: SkillItem[];
}

const { items } = Astro.props;

const levelMark = (value: number) => (value >= 3 ? '+++' : value === 2 ? '++' : '+');
const levelName = (value: number) => (value >= 3 ? '熟练' : value === 2 ? '熟悉' : '了解');

const count = (value: number) => items.filter((item) => item.value === value).length;
const ariaSummary =
  `职业技能分布饼图，共 ${items.length} 项：` +
  `熟练 ${count(3)} 项、熟悉 ${count(2)} 项、了解 ${count(1)} 项。`;

const size = 540;
const height = 340;
const centerX = size / 2;
const centerY = height / 2;
const radius = 122;
const labelLineLength = 15;
const labelLineLength2 = 30;
const labelDistance = 5;
const labelMinY = 12;
const labelMaxY = height - 12;
const labelGapMax = 14;
const total = items.reduce((sum, item) => sum + item.value, 0) || 1;

const fillPercent = (value: number) => (value >= 3 ? 92 : value === 2 ? 72 : 52);
const sliceStyle = (index: number, value: number) => {
  const jitter = ((index * 37) % 9) - 4;
  const fill = Math.max(38, Math.min(96, fillPercent(value) + jitter));

  return `--slice-fill: color-mix(in oklab, var(--paper-accent) ${fill}%, var(--paper-surface));`;
};

type Slice = {
  name: string;
  value: number;
  percent: number;
  path: string;
  style: string;
  labelSide: 'left' | 'right';
  labelX: number;
  labelY: number;
  edgeX: number;
  edgeY: number;
  elbowX: number;
  lineEndX: number;
};

let currentAngle = -Math.PI / 2;
const slices: Slice[] = items.map((item, index) => {
  const startAngle = currentAngle;
  const sweep = (item.value / total) * Math.PI * 2;
  const endAngle = startAngle + sweep;
  currentAngle = endAngle;

  const x1 = centerX + radius * Math.cos(startAngle);
  const y1 = centerY + radius * Math.sin(startAngle);
  const x2 = centerX + radius * Math.cos(endAngle);
  const y2 = centerY + radius * Math.sin(endAngle);
  const largeArc = sweep > Math.PI ? 1 : 0;

  const middleAngle = startAngle + sweep / 2;
  const offsetX = Math.cos(middleAngle) * 14;
  const offsetY = Math.sin(middleAngle) * 14;
  const nx = Math.cos(middleAngle);
  const ny = Math.sin(middleAngle);
  const dir = nx >= 0 ? 1 : -1;
  const edgeX = centerX + radius * nx;
  const edgeY = centerY + radius * ny;
  const elbowX = edgeX + nx * labelLineLength;
  const elbowY = edgeY + ny * labelLineLength;
  const lineEndX = elbowX + dir * labelLineLength2;
  const labelX = lineEndX + dir * labelDistance;

  return {
    ...item,
    percent: Math.round((item.value / total) * 100),
    path: `M ${centerX} ${centerY} L ${x1.toFixed(2)} ${y1.toFixed(2)} A ${radius} ${radius} 0 ${largeArc} 1 ${x2.toFixed(2)} ${y2.toFixed(2)} Z`,
    style:
      `${sliceStyle(index, item.value)} ` +
      `--slice-tx: ${offsetX.toFixed(2)}px; --slice-ty: ${offsetY.toFixed(2)}px;`,
    labelSide: dir > 0 ? 'right' : 'left',
    labelX,
    labelY: elbowY,
    edgeX,
    edgeY,
    elbowX,
    lineEndX,
  };
});

for (const side of ['left', 'right'] as const) {
  const group = slices
    .filter((slice) => slice.labelSide === side)
    .sort((a, b) => a.labelY - b.labelY);

  if (group.length === 0) continue;

  const gap = Math.min(labelGapMax, (labelMaxY - labelMinY) / Math.max(1, group.length - 1));
  let previousY = labelMinY - gap;
  for (const slice of group) {
    slice.labelY = Math.max(slice.labelY, previousY + gap);
    previousY = slice.labelY;
  }

  let nextY = labelMaxY + gap;
  for (let index = group.length - 1; index >= 0; index--) {
    const slice = group[index];
    slice.labelY = Math.min(slice.labelY, nextY - gap);
    nextY = slice.labelY;
  }

  const dir = side === 'right' ? 1 : -1;
  const radialEnd = radius + labelLineLength;
  let ellipseRadiusY = radialEnd;
  let maxDy = -1;
  for (const slice of group) {
    const dy = Math.abs(slice.labelY - centerY);
    if (dy >= maxDy) {
      const dx = slice.labelX - centerX - labelLineLength2 * dir;
      const ratio = Math.abs(dx) < radialEnd ? 1 - (dx * dx) / (radialEnd * radialEnd) : 0;
      ellipseRadiusY = ratio > 0 ? Math.sqrt((dy * dy) / ratio) : radialEnd;
      maxDy = dy;
    }
  }

  for (const slice of group) {
    const dy = Math.abs(slice.labelY - centerY);
    const ratio = Math.max(0, 1 - (dy * dy) / (ellipseRadiusY * ellipseRadiusY));
    const dx = Math.sqrt(ratio * radialEnd * radialEnd);
    slice.labelX = centerX + (dx + labelLineLength2) * dir;
    slice.lineEndX = slice.labelX - dir * labelDistance;
    slice.elbowX = slice.lineEndX - dir * labelLineLength2;
  }
}
---

<div class="skill-pie" data-skill-pie>
  <!-- 自定义图例：点击凸出扇区，而不是隐藏数据 -->
  <div class="skill-pie__legend">
    {items.map((item, index) => (
      <button
        type="button"
        class="skill-pie__legend-item"
        style={sliceStyle(index, item.value)}
        data-name={item.name}
        data-legend
        aria-pressed="false"
        aria-label={`${item.name}，${levelName(item.value)}${levelMark(item.value)}`}
      >
        <span class="skill-pie__swatch" aria-hidden="true" />
        <span class="skill-pie__legend-name">{item.name}</span>
        <span class="skill-pie__legend-level" aria-hidden="true">
          {levelMark(item.value)}
        </span>
      </button>
    ))}
  </div>
  <div class="skill-pie__chart">
    <svg
      class="skill-pie__svg"
      viewBox={`0 0 ${size} ${height}`}
      role="img"
      aria-label={ariaSummary}
    >
      {slices.map((slice) => (
        <g
          class="skill-pie__slice-group"
          style={slice.style}
          data-slice-group
          data-name={slice.name}
        >
          <path class="skill-pie__slice" d={slice.path} data-name={slice.name} data-slice>
            <title>{`${slice.name} · ${levelName(slice.value)}${levelMark(slice.value)} · ${slice.percent}%`}</title>
          </path>
          <path
            class="skill-pie__label-line"
            d={`M ${slice.edgeX.toFixed(2)} ${slice.edgeY.toFixed(2)} L ${slice.elbowX.toFixed(2)} ${slice.labelY.toFixed(2)} L ${slice.lineEndX.toFixed(2)} ${slice.labelY.toFixed(2)}`}
            aria-hidden="true"
          />
          <text
            class="skill-pie__label"
            x={slice.labelX}
            y={slice.labelY}
            text-anchor={slice.labelSide === 'right' ? 'start' : 'end'}
            dominant-baseline="middle"
            aria-hidden="true"
            data-label
            data-name={slice.name}
          >
            {slice.name}
          </text>
        </g>
      ))}
    </svg>
  </div>
</div>

<script>
  const setup = () => {
    document.querySelectorAll<HTMLElement>('[data-skill-pie]').forEach((host) => {
      if (host.dataset.wired) return;
      host.dataset.wired = 'true';

      const slices = Array.from(host.querySelectorAll<SVGPathElement>('[data-slice]'));
      const groups = Array.from(host.querySelectorAll<SVGGElement>('[data-slice-group]'));
      const buttons = Array.from(host.querySelectorAll<HTMLButtonElement>('[data-legend]'));
      const selected = new Set<string>();
      const groupByName = new Map(groups.map((group) => [group.dataset.name ?? '', group]));
      const buttonByName = new Map(buttons.map((button) => [button.dataset.name ?? '', button]));

      const sync = () => {
        buttons.forEach((button) => {
          const active = selected.has(button.dataset.name ?? '');
          button.setAttribute('aria-pressed', String(active));
          button.classList.toggle('is-active', active);
        });
        groups.forEach((group) => {
          group.classList.toggle('is-selected', selected.has(group.dataset.name ?? ''));
        });
      };

      const setHover = (name: string, active: boolean) => {
        groupByName.get(name)?.classList.toggle('is-hover', active);
        buttonByName.get(name)?.classList.toggle('is-hover', active);
      };

      const toggle = (name: string) => {
        if (!name) return;
        if (selected.has(name)) selected.delete(name);
        else selected.add(name);
        sync();
      };

      buttons.forEach((button) => {
        const name = button.dataset.name ?? '';
        button.addEventListener('mouseenter', () => setHover(name, true));
        button.addEventListener('mouseleave', () => setHover(name, false));
        button.addEventListener('focus', () => setHover(name, true));
        button.addEventListener('blur', () => setHover(name, false));
        button.addEventListener('click', () => toggle(name));
      });

      slices.forEach((slice) => {
        const name = slice.dataset.name ?? '';
        slice.addEventListener('mouseenter', () => setHover(name, true));
        slice.addEventListener('mouseleave', () => setHover(name, false));
        slice.addEventListener('click', () => toggle(name));
      });
    });
  };

  setup();
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  /* 容器：桌面端图例在左、饼图在右 */
  .skill-pie {
    display: flex;
    gap: 1.5rem;
    align-items: stretch;
    margin: 1.5rem 0 2rem;
  }

  /* 图例列：固定宽度，条目多时在列内滚动，不撑破版心 */
  .skill-pie__legend {
    flex: 0 0 11.5rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-height: 28.75rem;
    overflow-y: auto;
    padding-right: 0.25rem;
  }

  /* 注意：Chrome 121+ 只要元素上出现 scrollbar-width / scrollbar-color，
     就会忽略下面整套 ::-webkit-scrollbar 规则并退回原生滚动条（带箭头和灰轨道），
     所以标准属性只在不支持 webkit 伪元素的 Firefox 里生效，两套写法严格分开。
     与首页 DoingCard 的 activity-feed 同一套模式。 */
  @supports selector(::-webkit-scrollbar) {
    /* Chromium / Safari：完全接管滚动条，6px 细条 */
    .skill-pie__legend::-webkit-scrollbar {
      width: 6px;
    }

    /* 轨道透明，直接透出版心背景 */
    .skill-pie__legend::-webkit-scrollbar-track {
      background: transparent;
    }

    /* 滑块默认透明：鼠标不在图例列区域时整条滚动条不可见 */
    .skill-pie__legend::-webkit-scrollbar-thumb {
      background: transparent;
      border-radius: 999px;
    }

    /* 去掉滚动条上下箭头按钮 */
    .skill-pie__legend::-webkit-scrollbar-button:vertical:start:decrement,
    .skill-pie__legend::-webkit-scrollbar-button:vertical:end:increment,
    .skill-pie__legend::-webkit-scrollbar-button:vertical:single-button {
      display: none;
      background: transparent;
      height: 0;
    }

    /* 鼠标进入图例列时才显示滑块（轨道始终保持透明） */
    .skill-pie__legend:hover::-webkit-scrollbar-thumb,
    .skill-pie__legend:focus-visible::-webkit-scrollbar-thumb {
      background: var(--paper-ink-faint);
    }
  }

  @supports not selector(::-webkit-scrollbar) {
    /* Firefox：默认完全隐藏滚动条，悬停或键盘聚焦时显示细滚动条 */
    .skill-pie__legend {
      scrollbar-width: none;
    }

    .skill-pie__legend:hover,
    .skill-pie__legend:focus-visible {
      scrollbar-width: thin;
      scrollbar-color: var(--paper-ink-faint) transparent;
    }
  }

  .skill-pie__legend-item {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    width: 100%;
    padding: 0.22rem 0.4rem;
    margin: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--paper-ink-soft);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.78rem;
    line-height: 1.5;
    text-align: left;
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .skill-pie__legend-item:hover,
  .skill-pie__legend-item:focus-visible,
  .skill-pie__legend-item.is-hover {
    color: var(--paper-ink);
    background: color-mix(in srgb, var(--paper-accent) 7%, transparent);
    outline: none;
  }

  .skill-pie__legend-item.is-active {
    color: var(--paper-ink);
    background: color-mix(in srgb, var(--paper-accent) 12%, transparent);
  }

  .skill-pie__swatch {
    flex: 0 0 0.55rem;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 2px;
    background: var(--slice-fill, var(--paper-accent));
  }

  .skill-pie__legend-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .skill-pie__legend-level {
    color: var(--paper-ink-faint);
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    letter-spacing: 0.02em;
  }

  /* 饼图区：SVG 使用 viewBox，父容器给高度以保证和左侧图例对齐 */
  .skill-pie__chart {
    flex: 1;
    display: grid;
    min-width: 0;
    height: 28.75rem;
    place-items: center;
  }

  .skill-pie__svg {
    width: 100%;
    height: 100%;
    max-height: 28.75rem;
    overflow: visible;
  }

  .skill-pie__slice-group {
    transition: transform 160ms ease;
  }

  .skill-pie__slice-group.is-selected {
    transform: translate(var(--slice-tx, 0), var(--slice-ty, 0));
  }

  .skill-pie__slice {
    fill: var(--slice-fill, var(--paper-accent));
    stroke: var(--paper-surface);
    stroke-width: 1.5;
    stroke-linejoin: round;
    cursor: pointer;
    transition: filter 160ms ease;
  }

  .skill-pie__slice:hover,
  .skill-pie__slice-group.is-hover .skill-pie__slice {
    filter: brightness(1.06);
  }

  .skill-pie__label-line {
    fill: none;
    stroke: color-mix(in oklab, var(--slice-fill) 55%, var(--paper-ink-faint));
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
    transition: stroke 160ms ease;
  }

  .skill-pie__label {
    fill: color-mix(in oklab, var(--slice-fill) 65%, var(--paper-ink));
    font-family: var(--font-body);
    font-size: 10px;
    letter-spacing: 0.01em;
    paint-order: stroke;
    stroke: var(--paper-surface);
    stroke-width: 2.4px;
    stroke-linejoin: round;
    pointer-events: none;
    transition: fill 160ms ease;
  }

  .skill-pie__slice-group.is-hover .skill-pie__label,
  .skill-pie__slice-group.is-selected .skill-pie__label {
    fill: var(--paper-ink);
  }

  .skill-pie__slice-group.is-hover .skill-pie__label-line,
  .skill-pie__slice-group.is-selected .skill-pie__label-line {
    stroke: var(--paper-accent);
  }

  @media (max-width: 640px) {
    .skill-pie {
      flex-direction: column;
      gap: 1rem;
    }

    /* 窄屏：饼图置顶，图例改为整行跟随（页面本身可纵向滚动）；
       flex 必须重置为 none——column 布局下 flex:1 的 flex-basis:0% 会压掉 height */
    .skill-pie__chart {
      flex: none;
      order: -1;
      height: 20rem;
    }

    .skill-pie__legend {
      flex: none;
      max-height: none;
      overflow-y: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-pie__legend-item,
    .skill-pie__slice,
    .skill-pie__slice-group,
    .skill-pie__label,
    .skill-pie__label-line {
      transition: none;
    }
  }
</style>
