---
// 关于页职业技能环形图：每片独立色（oklch 默认色相按索引均分，可用 item.color 覆盖）。
// 构建时生成骨架、客户端绘制 SVG 弧；无 JS 时仍有隐藏摘要列表可读。
interface SkillItem {
  name: string;
  value: number;
  color?: string;
}

interface Props {
  items: SkillItem[];
}

const { items } = Astro.props;
---

<div class="skill-pie" data-skill-pie data-items={JSON.stringify(items)}></div>
<ul class="skill-pie__sr-only" aria-label="技能分布摘要">
  {items.map((item) => (
    <li>
      {item.name}：{item.value}
    </li>
  ))}
</ul>

<script>
  const setup = () => {
    document.querySelectorAll<HTMLElement>('[data-skill-pie]').forEach((host) => {
      if (host.dataset.wired) return;
      host.dataset.wired = 'true';

      const items = JSON.parse(host.dataset.items || '[]') as {
        name: string;
        value: number;
        color?: string;
      }[];
      const total = items.reduce((s, i) => s + i.value, 0) || 1;

      const size = 620;
      const height = 360;
      const cx = size / 2;
      const cy = height / 2;
      const outer = 118;
      const inner = 70;
      const labelRadius = outer + 16;
      const labelMinY = 14;
      const labelMaxY = height - 14;
      const labelGap = 13;

      const hueFor = (index: number) => Math.round((index * 360) / Math.max(items.length, 1));
      const colorFor = (index: number) => items[index].color || `oklch(70% 0.075 ${hueFor(index)})`;

      const polar = (r: number, a: number) => [cx + r * Math.cos(a), cy + r * Math.sin(a)];

      const arcPath = (start: number, end: number) => {
        const [x1, y1] = polar(outer, start);
        const [x2, y2] = polar(outer, end);
        const [x3, y3] = polar(inner, end);
        const [x4, y4] = polar(inner, start);
        const large = end - start > Math.PI ? 1 : 0;
        return (
          `M ${x1.toFixed(2)} ${y1.toFixed(2)} ` +
          `A ${outer} ${outer} 0 ${large} 1 ${x2.toFixed(2)} ${y2.toFixed(2)} ` +
          `L ${x3.toFixed(2)} ${y3.toFixed(2)} ` +
          `A ${inner} ${inner} 0 ${large} 0 ${x4.toFixed(2)} ${y4.toFixed(2)} Z`
        );
      };

      const svgNS = 'http://www.w3.org/2000/svg';
      const svg = document.createElementNS(svgNS, 'svg');
      svg.setAttribute('class', 'skill-pie__svg');
      svg.setAttribute('viewBox', `0 0 ${size} ${height}`);
      svg.setAttribute('role', 'img');
      svg.setAttribute(
        'aria-label',
        `职业技能分布环形图，共 ${items.length} 项，按熟练度从高到低排列`,
      );

      type LabelInfo = {
        g: SVGGElement;
        text: SVGTextElement;
        line: SVGPathElement;
        color: string;
        side: 'left' | 'right';
        y: number;
        x: number;
      };
      const labels: LabelInfo[] = [];

      let angle = -Math.PI / 2;
      items.forEach((item, index) => {
        const sweep = (item.value / total) * Math.PI * 2;
        const start = angle;
        const end = angle + sweep;
        angle = end;
        const mid = start + sweep / 2;

        const color = colorFor(index);
        const [dx, dy] = [Math.cos(mid), Math.sin(mid)];

        const g = document.createElementNS(svgNS, 'g');
        g.setAttribute('class', 'skill-pie__slice-group');
        g.dataset.name = item.name;
        g.style.setProperty('--explode-x', `${(dx * 12).toFixed(2)}px`);
        g.style.setProperty('--explode-y', `${(dy * 12).toFixed(2)}px`);
        g.style.setProperty('--slice-color', color);

        const path = document.createElementNS(svgNS, 'path');
        path.setAttribute('class', 'skill-pie__slice');
        path.setAttribute('d', arcPath(start, end));

        const title = document.createElementNS(svgNS, 'title');
        title.textContent = `${item.name} · ${item.value}`;
        path.appendChild(title);
        g.appendChild(path);

        // 标签：放在扇区弧线外侧
        const text = document.createElementNS(svgNS, 'text');
        text.setAttribute('class', 'skill-pie__label');
        text.setAttribute('dominant-baseline', 'middle');
        text.textContent = item.name;

        const line = document.createElementNS(svgNS, 'path');
        line.setAttribute('class', 'skill-pie__label-line');
        g.appendChild(line);
        g.appendChild(text);
        svg.appendChild(g);

        const [ex, ey] = polar(labelRadius, mid);
        labels.push({
          g,
          text,
          line,
          color,
          side: dx >= 0 ? 'right' : 'left',
          y: ey,
          x: ex,
        });

        const toggle = () => g.classList.toggle('is-selected');
        path.addEventListener('click', toggle);
        path.addEventListener('mouseenter', () => g.classList.add('is-hover'));
        path.addEventListener('mouseleave', () => g.classList.remove('is-hover'));
      });

      // 标签防重叠：左右两侧各自按 y 排序后按最小间距推开
      for (const side of ['right', 'left'] as const) {
        const group = labels.filter((l) => l.side === side).sort((a, b) => a.y - b.y);
        if (!group.length) continue;

        const gap = Math.min(labelGap, (labelMaxY - labelMinY) / Math.max(1, group.length - 1));
        let prev = labelMinY - gap;
        for (const l of group) {
          l.y = Math.max(l.y, prev + gap);
          prev = l.y;
        }
        let next = labelMaxY + gap;
        for (let i = group.length - 1; i >= 0; i--) {
          group[i].y = Math.min(group[i].y, next - gap);
          next = group[i].y;
        }
      }

      for (const l of labels) {
        const dir = l.side === 'right' ? 1 : -1;
        const anchorX = cx + dir * (outer + 6);
        const endX = cx + dir * (outer + 24);
        l.line.setAttribute(
          'd',
          `M ${anchorX.toFixed(2)} ${l.y.toFixed(2)} L ${endX.toFixed(2)} ${l.y.toFixed(2)}`,
        );
        l.text.setAttribute('x', (endX + dir * 5).toFixed(2));
        l.text.setAttribute('y', l.y.toFixed(2));
        l.text.setAttribute('text-anchor', l.side === 'right' ? 'start' : 'end');
        l.text.style.fill = l.color;
        l.line.style.stroke = l.color;
      }

      host.appendChild(svg);
    });
  };

  setup();
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .skill-pie {
    display: flex;
    justify-content: center;
    margin: 1.5rem 0 2rem;
  }

  .skill-pie__svg {
    width: 100%;
    max-width: 38rem;
    height: auto;
    max-height: 26rem;
    animation: pie-fade-in 640ms ease both;
  }

  .skill-pie__slice-group {
    transition: transform 220ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .skill-pie__slice-group.is-hover {
    transform: scale(1.035);
    transform-box: view-box;
    transform-origin: center;
  }

  .skill-pie__slice-group.is-selected {
    transform: translate(var(--explode-x, 0), var(--explode-y, 0));
  }

  .skill-pie__slice-group.is-hover.is-selected {
    transform: translate(var(--explode-x, 0), var(--explode-y, 0)) scale(1.035);
  }

  .skill-pie__slice {
    fill: var(--slice-color, var(--paper-accent));
    stroke: var(--paper-surface);
    stroke-width: 2;
    stroke-linejoin: round;
    cursor: pointer;
    transition:
      filter 220ms ease,
      opacity 220ms ease;
  }

  /* 悬停时其余扇区变淡，突出当前项 */
  .skill-pie__svg:has(.skill-pie__slice-group.is-hover)
    .skill-pie__slice-group:not(.is-hover)
    .skill-pie__slice {
    opacity: 0.4;
  }

  .skill-pie__slice-group.is-hover .skill-pie__slice {
    filter: brightness(1.1);
  }

  .skill-pie__label-line {
    fill: none;
    stroke-width: 1;
    stroke-linecap: round;
    opacity: 0.75;
    pointer-events: none;
    transition: opacity 220ms ease;
  }

  .skill-pie__label {
    font-family: var(--font-body);
    font-size: 10px;
    letter-spacing: 0.01em;
    pointer-events: none;
    transition:
      fill 220ms ease,
      opacity 220ms ease;
  }

  .skill-pie__slice-group.is-hover .skill-pie__label,
  .skill-pie__slice-group.is-selected .skill-pie__label {
    font-weight: 700;
  }

  .skill-pie__slice-group.is-selected .skill-pie__label-line {
    opacity: 1;
  }

  .skill-pie__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes pie-fade-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (max-width: 640px) {
    .skill-pie__label {
      font-size: 9px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-pie__svg {
      animation: none;
    }
    .skill-pie__slice-group,
    .skill-pie__slice,
    .skill-pie__label,
    .skill-pie__label-line {
      transition: none;
    }
  }
</style>
