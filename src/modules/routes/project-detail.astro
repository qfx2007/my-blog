---
import { getCollection, render } from 'astro:content';
import BlogArticle from '../../layouts/BlogArticle.astro';
// 项目详情正文图片映射为 ZoomableImage，获得与博客详情一致的点击放大能力
import ZoomableImage from '@navfolio/mdx-components/ZoomableImage.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ id, data }) => id !== 'index' && !data.draft);

  return projects.map((project) => ({
    params: { slug: project.id },
    props: project,
  }));
}

const project = Astro.props;
const { Content, headings } = await render(project);
---

<BlogArticle
  post={project}
  headings={headings}
  sidebar={{ enable: false, ...project.data.sidebar }}
>
  <Content components={{ img: ZoomableImage }} />
</BlogArticle>
